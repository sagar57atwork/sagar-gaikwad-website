---
const SITE = "https://sagar-gaikwad-website.pages.dev";

const work = [
  {
    number: "01",
    type: "PRODUCT / SYSTEM",
    title: "Ripple Fable Research OS",
    text: "A Windows-based marketing research workspace designed to turn scattered research into structured evidence, insights and strategy.",
    tags: ["Research", "AI", "Strategy"],
    featured: true,
  },
  {
    number: "02",
    type: "AGENCY SYSTEM",
    title: "Retention Engine",
    text: "A Notion operating system for managing clients, projects, retention, strategy, analytics and delivery.",
    tags: ["Notion", "Agency Ops", "Retention"],
    featured: true,
  },
  {
    number: "03",
    type: "STRATEGIC PROJECT",
    title: "Competitive Intelligence Report",
    text: "A structured competitive research system for understanding market positioning, competitors and strategic opportunities.",
    tags: ["Local SEO", "Research", "Acquisition"],
    featured: false,
  },
  {
    number: "04",
    type: "PRACTICE CASE STUDY",
    title: "Local Search Growth",
    text: "A research-led approach to Google Business Profile, local SEO and customer acquisition for local businesses.",
    tags: ["Positioning", "Growth"],
    featured: false,
  },
  {
    number: "05",
    type: "PRACTICE CASE STUDY",
    title: "Luma Living",
    text: "A brand launch and go-to-market strategy exploring positioning, audience and growth direction.",
    tags: ["Brand", "GTM", "Strategy"],
    featured: false,
  },
  {
    number: "06",
    type: "PRACTICE CASE STUDY",
    title: "Harvest & Hearth",
    text: "A strategic exploration of digital positioning, content and growth opportunities for a restaurant brand.",
    tags: ["Strategy", "Content", "Growth"],
    featured: false,
  },
];

const capabilityGroups = [
  { label: "Strategy", items: ["Marketing Strategy", "Growth Strategy", "Brand Positioning"] },
  { label: "Research", items: ["Market Research", "Competitor Intelligence"] },
  { label: "Digital", items: ["SEO & Local SEO", "Content Strategy"] },
  { label: "AI & Systems", items: ["AI-Powered Marketing", "Research Systems"] },
];

const insights = [
  { title: "Why Marketing Strategy Should Start With Research", slug: "marketing-strategy-test" },
  { title: "What AI changes about modern marketing research", slug: "what-ai-changes-about-modern-marketing-research" },
  { title: "Why good content strategy starts with positioning", slug: "why-good-content-strategy-starts-with-positioning" },
];

const process = [
  ["01", "Understand", "Understand the business, audience, market and objective."],
  ["02", "Research", "Study competitors, customers, search behaviour and available evidence."],
  ["03", "Find the signal", "Identify patterns, opportunities, gaps and strategic implications."],
  ["04", "Build the strategy", "Turn the evidence into positioning, messaging, channels and priorities."],
  ["05", "Execute & learn", "Turn strategy into action, measure what happens and improve."],
];

const linkedinPosts = [
  { date: "Marketing Strategy", title: "Marketing strategy should start with research", text: "Understanding the market and the audience comes before choosing channels. Tactics chosen without evidence are guesses that only look like strategy." },
  { date: "AI & Marketing", title: "AI is changing how marketing research gets done", text: "AI is not replacing the researcher — it collapses the time between gathering evidence and finding the signal. The advantage goes to people who structure research well enough to use it responsibly." },
  { date: "Content Strategy", title: "Why content strategy starts with positioning", text: "Content works when it knows who it is for and what belief it is meant to change. Positioning comes first; the content is just what that position sounds like in practice." },
];

const slugify = (value) =>
  value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="google-site-verification" content="44d5opceRwMNyOuI_oBXH7zTQgUNM4XkzkBGymGTCmQ" />
    <title>Sagar Gaikwad | Marketing Strategist</title>

    <meta
      name="description"
      content="Sagar Gaikwad is a Marketing Strategist focused on marketing strategy, research, SEO, content, positioning, AI-powered marketing and growth."
    />

    <meta
      name="keywords"
      content="Sagar Gaikwad, Marketing Strategist, Marketing Strategy, SEO, Market Research, Growth Strategy, AI Marketing"
    />

    <meta name="author" content="Sagar Gaikwad" />

<link rel="canonical" href={SITE} />

<!-- Open Graph -->
<meta property="og:title" content="Sagar Gaikwad | Marketing Strategist" />
<meta property="og:description" content="Sagar Gaikwad is a Marketing Strategist focused on marketing strategy, research, SEO, content, positioning, AI-powered marketing and growth." />
<meta property="og:url" content={SITE} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Sagar Gaikwad" />

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content="Sagar Gaikwad | Marketing Strategist" />
<meta name="twitter:description" content="Sagar Gaikwad is a Marketing Strategist focused on marketing strategy, research, SEO, content, positioning, AI-powered marketing and growth." />

    <style>
      :root {
        --paper: #f7f6f2;
        --paper-dark: #eeece6;
        --ink: #171717;
        --muted: #676761;
        --line: #d9d7d0;
        --yellow: #f5c518;
        --orange: #f57722;
        --orange-soft: #fff0e5;
        --white: #ffffff;
        --max: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(var(--max), calc(100% - 56px));
        margin: 0 auto;
      }

      /* NAV */

      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(247, 246, 242, 0.94);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
      }

      .nav-inner {
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        font-size: 15px;
        font-weight: 650;
        letter-spacing: -0.01em;
      }

      .brand-mark {
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border: 1px solid var(--ink);
        font-family: Georgia, serif;
        font-size: 17px;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 30px;
        color: #555550;
        font-size: 14px;
      }

      .nav-links a {
        transition: color 0.2s ease;
      }

      .nav-links a:hover {
        color: var(--ink);
      }

      .nav-contact {
        border-bottom: 1px solid var(--ink);
        padding-bottom: 2px;
        font-size: 14px;
        font-weight: 600;
      }

      /* HERO */

      .hero {
        padding: 125px 0 130px;
        border-bottom: 1px solid var(--line);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.35fr 0.65fr;
        gap: 80px;
        align-items: end;
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 30px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 650;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .eyebrow-dot {
        width: 8px;
        height: 8px;
        background: var(--orange);
        border-radius: 50%;
      }

      h1 {
        max-width: 850px;
        margin: 0;
        font-size: clamp(44px, 5.8vw, 74px);
        line-height: 1.03;
        letter-spacing: -0.055em;
        font-weight: 620;
      }

      h1 em {
        font-family: Georgia, "Times New Roman", serif;
        font-weight: 400;
        color: #454541;
      }

      .hero-side {
        padding-bottom: 7px;
      }

      .hero-side p {
        margin: 0 0 28px;
        color: var(--muted);
        font-size: 17px;
        line-height: 1.75;
      }

      .hero-links {
        display: flex;
        gap: 22px;
        flex-wrap: wrap;
      }

      .text-link {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        border-bottom: 1px solid var(--ink);
        padding-bottom: 3px;
        font-size: 14px;
        font-weight: 650;
      }

      .text-link.orange {
        border-color: var(--orange);
      }

      /* INTRO */

      .intro {
        padding: 95px 0;
      }

      .intro-grid {
        display: grid;
        grid-template-columns: 0.55fr 1.45fr;
        gap: 80px;
      }

      .section-label {
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .intro h2 {
        max-width: 800px;
        margin: 0;
        font-size: clamp(34px, 4.2vw, 58px);
        line-height: 1.08;
        letter-spacing: -0.045em;
        font-weight: 600;
      }

      .intro h2 span {
        color: var(--orange);
      }

      /* ABOUT */

      .about {
        padding: 0 0 105px;
      }

      .about-box {
        display: grid;
        grid-template-columns: 0.7fr 1.3fr;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .about-photo {
  min-height: 420px;
  background: var(--paper);
  border-right: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

      .profile-photo {
  width: calc(100% - 24px);
  height: calc(100% - 24px);
  object-fit: cover;
  object-position: center 22%;
  display: block;
}

      .about-copy {
        padding: 58px 65px;
      }

      .about-copy h3 {
        margin: 0 0 22px;
        font-size: 31px;
        line-height: 1.2;
        letter-spacing: -0.035em;
      }

      .about-copy p {
        max-width: 680px;
        margin: 0 0 18px;
        color: var(--muted);
        font-size: 16px;
        line-height: 1.8;
      }

      .about-note {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 28px;
        padding-top: 18px;
        border-top: 1px solid var(--line);
        font-size: 13px;
        font-weight: 650;
        letter-spacing: .02em;
      }

      .about-note-dot {
        width: 7px;
        height: 7px;
        background: var(--orange);
        border-radius: 50%;
      }

      /* WORK */

      .work {
        padding: 105px 0;
        background: var(--white);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 50px;
      }

      .section-head h2 {
        margin: 10px 0 0;
        font-size: clamp(38px, 5vw, 64px);
        line-height: 1;
        letter-spacing: -0.05em;
        font-weight: 600;
      }

      .section-head p {
        max-width: 430px;
        margin: 0;
        color: var(--muted);
        font-size: 15px;
      }

      .work-list {
        border-top: 1px solid var(--line);
      }

      .work-item {
        display: grid;
        grid-template-columns: 70px 190px 1fr 40px;
        gap: 28px;
        align-items: start;
        padding: 35px 0;
        border-bottom: 1px solid var(--line);
        position: relative;
        transition: background 0.25s ease;
      }

      .work-item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: var(--orange);
        opacity: 0;
        transition: opacity 0.25s ease;
      }

      .work-item:hover {
        background: var(--paper-dark);
      }

      .work-item:hover::before {
        opacity: 1;
      }

      .work-number {
        color: #aaa8a0;
        font-size: 13px;
        padding-top: 5px;
      }

      .work-type {
        color: var(--orange);
        font-size: 10px;
        font-weight: 750;
        letter-spacing: 0.14em;
        line-height: 1.5;
        padding-top: 6px;
      }

      .work-content h3 {
        margin: 0 0 9px;
        font-size: 27px;
        line-height: 1.2;
        letter-spacing: -0.035em;
        font-weight: 600;
      }

      .work-content p {
        max-width: 680px;
        margin: 0;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.7;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 17px;
      }

      .tag {
        padding: 4px 8px;
        border: 1px solid var(--line);
        color: #77756f;
        font-size: 11px;
      }

      .work-arrow {
        padding-top: 3px;
        font-size: 20px;
        color: #88867f;
        transition: transform 0.25s ease, color 0.25s ease;
      }

      .work-item:hover .work-arrow {
        transform: translateX(4px);
        color: var(--orange);
      }

      /* CAPABILITIES */

      .capabilities {
        padding: 105px 0;
      }

      .capability-groups {
        margin-top: 50px;
        border-top: 1px solid var(--line);
      }

      .capability-group {
        display: grid;
        grid-template-columns: 210px 1fr;
        gap: 40px;
        padding: 26px 0;
        border-bottom: 1px solid var(--line);
      }

      .capability-label {
        color: var(--orange);
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding-top: 4px;
      }

      .capability-items {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 44px;
        font-size: 17px;
      }

      .capability-item {
        position: relative;
        padding-left: 16px;
      }

      .capability-item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.68em;
        width: 6px;
        height: 6px;
        background: var(--yellow);
        border-radius: 50%;
      }

      /* SYSTEMS */

      .systems {
        padding: 105px 0;
        background: var(--paper-dark);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .system-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-top: 50px;
      }

      .system {
        padding: 38px;
        background: var(--paper);
        border: 1px solid var(--line);
      }

      .system-label {
        color: var(--orange);
        font-size: 10px;
        font-weight: 750;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .system h3 {
        margin: 18px 0 12px;
        font-size: 28px;
        letter-spacing: -0.035em;
      }

      .system p {
        margin: 0;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.75;
      }

      .system-link {
        display: inline-block;
        margin-top: 25px;
        border-bottom: 1px solid var(--ink);
        font-size: 13px;
        font-weight: 650;
      }

      /* INSIGHTS */

      .insights {
        padding: 105px 0;
      }

      .insight-list {
        margin-top: 50px;
        border-top: 1px solid var(--line);
      }

      .insight {
        display: grid;
        grid-template-columns: 70px 1fr 30px;
        gap: 30px;
        align-items: center;
        padding: 26px 0;
        border-bottom: 1px solid var(--line);
      }

      .insight-number {
        color: #aaa8a0;
        font-size: 12px;
      }

      .insight-title {
        font-size: 20px;
        letter-spacing: -0.02em;
      }

      .insight-arrow {
        color: var(--orange);
      }

      /* PROCESS */

      .process {
        padding: 105px 0;
        border-top: 1px solid var(--line);
      }

      .process-grid {
        margin-top: 60px;
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 0;
      }

      .process-step {
        position: relative;
        padding: 26px 34px 0 0;
      }

      .process-step::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 44px;
        height: 3px;
        background: var(--orange);
      }

      .process-step:not(:last-child)::after {
        content: "→";
        position: absolute;
        top: 30px;
        right: 6px;
        color: var(--line);
        font-size: 15px;
      }

      .process-number {
        color: var(--orange);
        font-size: 12px;
        font-weight: 750;
        letter-spacing: 0.1em;
        margin-top: 34px;
      }

      .process-step h3 {
        margin: 8px 0 12px;
        font-size: 22px;
        line-height: 1.15;
        letter-spacing: -0.03em;
        font-weight: 600;
      }

      .process-step p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.65;
      }

      /* LINKEDIN */

      .linkedin {
        padding: 105px 0;
        background: var(--white);
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .linkedin-list {
        margin-top: 50px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .linkedin-card {
        padding: 30px;
        border: 1px solid var(--line);
        background: var(--paper);
        min-height: 220px;
        display: flex;
        flex-direction: column;
      }

      .linkedin-card:hover {
        border-color: #c9c5bc;
      }

      .linkedin-card .post-label {
        color: var(--orange);
        font-size: 10px;
        font-weight: 750;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .linkedin-card h3 {
        margin: 18px 0 10px;
        font-size: 21px;
        line-height: 1.25;
        letter-spacing: -0.025em;
      }

      .linkedin-card p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.7;
      }

      .linkedin-profile-link {
        display: inline-flex;
        margin-top: auto;
        padding-top: 24px;
        font-size: 13px;
        font-weight: 650;
        border-bottom: 1px solid var(--ink);
        align-self: flex-start;
      }

      /* CTA */

      .cta {
        padding: 120px 0;
        background: var(--paper-dark);
        color: var(--ink);
        text-align: center;
        border-top: 1px solid var(--line);
      }

      .cta .section-label {
        color: var(--orange);
      }

      .cta h2 {
        max-width: 850px;
        margin: 20px auto;
        font-size: clamp(42px, 6vw, 75px);
        line-height: 1;
        letter-spacing: -0.055em;
        font-weight: 580;
      }

      .cta p {
        max-width: 550px;
        margin: 0 auto 32px;
        color: var(--muted);
        font-size: 16px;
      }

      .cta-button {
        display: inline-flex;
        padding: 13px 19px;
        background: var(--orange);
        color: var(--white);
        font-size: 14px;
        font-weight: 700;
        transition: transform 0.2s ease, background 0.2s ease;
      }

      .cta-button:hover {
        transform: translateY(-2px);
        background: #df6417;
      }

      .cta-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 22px;
        flex-wrap: wrap;
      }

      .cta-link {
        display: inline-flex;
        padding: 6px 0;
        color: var(--ink);
        font-size: 14px;
        font-weight: 700;
        border-bottom: 1px solid var(--ink);
      }

      .cta-link:hover {
        color: var(--orange);
        border-color: var(--orange);
      }

      /* FOOTER */

      footer {
        padding: 35px 0;
        background: var(--paper);
        color: var(--muted);
        border-top: 1px solid var(--line);
      }

      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        font-size: 13px;
      }

      .footer-links {
        display: flex;
        gap: 22px;
        flex-wrap: wrap;
      }

      .footer-links a:hover {
        color: var(--ink);
      }

      .footer-id {
        line-height: 1.5;
      }

      .footer-name {
        color: var(--ink);
        font-weight: 650;
      }

      .footer-studio {
        margin-top: 6px;
        color: var(--orange);
        font-size: 12px;
        letter-spacing: .02em;
      }

      /* MOBILE */

      @media (max-width: 850px) {
        .container {
          width: min(var(--max), calc(100% - 32px));
        }

        .nav-links {
          display: none;
        }

        .hero {
          padding: 85px 0 90px;
        }

        .hero-grid,
        .intro-grid,
        .about-box {
          grid-template-columns: 1fr;
          gap: 45px;
        }

        .hero-side {
          max-width: 600px;
        }

        .about-photo {
          min-height: 360px;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .about-copy {
          padding: 45px 28px;
        }

        .section-head {
          display: block;
        }

        .section-head p {
          margin-top: 20px;
        }

        .work-item {
          grid-template-columns: 45px 1fr 25px;
          gap: 15px;
        }

        .work-type {
          display: none;
        }

        .capability-group,
        .system-grid,
        .process-grid,
        .linkedin-list {
          grid-template-columns: 1fr;
        }

        .capability-group {
          gap: 12px;
          padding: 22px 0;
        }

        .capability-item {
          width: 100%;
        }

        .process-step {
          padding-bottom: 26px;
        }

        .process-step::after {
          display: none;
        }

        .linkedin-card {
          min-height: 190px;
        }

        .capability:nth-child(odd) {
          border-right: 0;
          padding-right: 0;
        }

        .capability:nth-child(even) {
          padding-left: 0;
        }

        .footer-inner {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>

  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a href="/" class="brand">
          <span class="brand-mark">S</span>
          <span>Sagar Gaikwad</span>
        </a>

        <nav class="nav-links">
          <a href="#about">About</a>
          <a href="#work">Work</a>
          <a href="#capabilities">Capabilities</a>
          <a href="#process">Process</a>
