---
const SITE = "https://sagargaikwad.com";

const linkedinUrl = "https://www.linkedin.com/in/sagargaikwadofficial/";

const posts = [
  { category: "Marketing Strategy", title: "Marketing strategy should start with research", text: "Understanding the market and the audience comes before choosing channels. Tactics chosen without evidence are guesses that only look like strategy.", url: linkedinUrl },
  { category: "AI & Marketing", title: "AI is changing how marketing research gets done", text: "AI is not replacing the researcher — it collapses the time between gathering evidence and finding the signal. The advantage goes to people who structure research well enough to use it responsibly.", url: linkedinUrl },
  { category: "Content Strategy", title: "Why content strategy starts with positioning", text: "Content works when it knows who it is for and what belief it is meant to change. Positioning comes first; the content is just what that position sounds like in practice.", url: linkedinUrl },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>LinkedIn | Sagar Gaikwad</title>

        <meta
      name="description"
      content="Selected marketing strategy, growth and AI insights from Sagar Gaikwad on LinkedIn."
    />

    <link rel="canonical" href={`${SITE}/linkedin`} />

    <meta property="og:title" content="LinkedIn | Sagar Gaikwad" />
    <meta
      property="og:description"
      content="Selected marketing strategy, growth and AI insights from Sagar Gaikwad on LinkedIn."
    />
    <meta property="og:url" content={`${SITE}/linkedin`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sagar Gaikwad" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="LinkedIn | Sagar Gaikwad" />
    <meta
      name="twitter:description"
      content="Selected marketing strategy, growth and AI insights from Sagar Gaikwad on LinkedIn."
    />

    <style>
      :root {
        --paper: #f7f6f2;
        --ink: #171717;
        --muted: #6b6b67;
        --line: #d9d7d0;
        --orange: #f57722;
        --yellow: #f5c518;
        --white: #ffffff;
        --max: 1000px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(var(--max), calc(100% - 40px));
        margin: auto;
      }

      nav {
        border-bottom: 1px solid var(--line);
      }

      .nav-inner {
        height: 72px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .brand {
        font-weight: 650;
      }

      .back {
        font-size: 14px;
        color: var(--muted);
      }

      main {
        padding: 110px 0;
      }

      .label {
        color: var(--orange);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .15em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 800px;
        margin: 18px 0 25px;
        font-size: clamp(48px, 7vw, 82px);
        line-height: .98;
        letter-spacing: -.06em;
        font-weight: 600;
      }

      .intro {
        max-width: 650px;
        color: var(--muted);
        font-size: 17px;
        line-height: 1.75;
      }

      .profile-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 34px;
        border-bottom: 2px solid var(--ink);
        padding-bottom: 5px;
        font-size: 15px;
        font-weight: 650;
        transition: color 0.2s ease, border-color 0.2s ease;
      }

      .profile-link:hover {
        color: var(--orange);
        border-color: var(--orange);
      }

      .posts {
        margin-top: 90px;
        border-top: 1px solid var(--line);
      }

      .post {
        display: grid;
        grid-template-columns: 170px 1fr 30px;
        gap: 35px;
        padding: 35px 0;
        border-bottom: 1px solid var(--line);
        transition: background 0.25s ease;
      }

      .post:hover {
        background: var(--white);
      }

      .category {
        color: var(--orange);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
      }

      h2 {
        margin: 0 0 10px;
        font-size: 25px;
        letter-spacing: -.03em;
      }

      .post p {
        margin: 0;
        color: var(--muted);
        line-height: 1.7;
      }

      .arrow {
        color: var(--orange);
        transition: transform 0.25s ease;
      }

      .post:hover .arrow {
        transform: translateX(3px);
      }

      @media (max-width: 700px) {
        main {
          padding: 75px 0;
        }

        .post {
          grid-template-columns: 1fr 25px;
          gap: 12px;
        }

        .category {
          grid-column: 1 / -1;
        }
      }
    </style>
  </head>

  <body>
    <nav>
      <div class="container nav-inner">
        <a href="/" class="brand">Sagar Gaikwad</a>
        <a href="/" class="back">← Back to portfolio</a>
      </div>
    </nav>

    <main>
      <div class="container">

        <div class="label">LinkedIn / Selected thinking</div>

        <h1>
          What I'm thinking about in public.
        </h1>

        <p class="intro">
          Selected ideas, observations and marketing perspectives from my
          LinkedIn presence — covering strategy, AI, growth, research and
          modern marketing.
        </p>

        <a
          class="profile-link"
          href={linkedinUrl}
          target="_blank"
          rel="noopener"
        >
          Visit my LinkedIn →
        </a>

        <div class="posts">
          {posts.map((post) => (
            <a
              class="post"
              href={post.url}
              target="_blank"
              rel="noopener"
            >
              <div class="category">{post.category}</div>

              <div>
                <h2>{post.title}</h2>
                <p>{post.text}</p>
              </div>

              <div class="arrow">↗</div>
            </a>
          ))}
        </div>

      </div>
    </main>
  </body>
</html>