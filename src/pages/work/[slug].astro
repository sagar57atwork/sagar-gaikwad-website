---
export function getStaticPaths() {
  const projects = [
    {
  slug: "dermabay-proof-gap",
  type: "STRATEGIC RESEARCH",
  title: "Dermabay: The Proof Gap",
  summary:
    "An independent strategic growth investigation into how science-backed credibility can become a more distinctive reason to choose.",
  role: "Digital Marketing Strategist",
  tools: ["Market Research", "Consumer Research", "Competitive Intelligence", "Strategy"],
  tags: ["Research", "Strategy", "Consumer Insight", "Growth"],
},
    { slug: "ripple-fable-research-os", type: "PRODUCT / SYSTEM", title: "Ripple Fable Research OS", summary: "A Windows-based marketing research workspace designed to turn scattered research into structured, usable analysis.", role: "Product / Research", tools: ["Windows App", "Research", "Strategy"], tags: ["Research", "AI", "Strategy"] },
    { slug: "retention-engine", type: "Internal Operations System", title: "Retention Engine", summary: "A Notion operating system for managing clients, projects, retention, strategy, analytics and delivery.", role: "System Design & Workflow Architecture", tools: ["Notion"], tags: ["Notion", "Agency Ops", "Retention"] },
    { slug: "not-worth-the-trip-zepto", type: "STRATEGY / CAMPAIGN", title: "Not Worth The Trip", summary: "A research-led strategic case study exploring how Zepto could move beyond the 10-minute delivery promise and own a more relevant form of urban convenience.", role: "Marketing Strategist", tools: ["Research", "Consumer Research", "Competitive Analysis", "Strategic Positioning", "Consumer Insight", "Campaign Strategy", "Creative Strategy", "Localisation", "Content Strategy", "Measurement Strategy"], tags: ["Research", "Strategy", "Consumer Insight", "Campaign"] },
  ];
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, projectsList: projects, index },
  }));
}

const { project, projectsList, index } = Astro.props;
const { title, type, summary, role, tools, tags } = project;

const SITE = "https://sagar-gaikwad-website.pages.dev";

const isPractice = /practice|concept/i.test(type);

const isDermabay = project.slug === "dermabay-proof-gap";
const isResearchOS = project.slug === "ripple-fable-research-os";
const isZepto = project.slug === "not-worth-the-trip-zepto";
const isRetention = project.slug === "retention-engine";

const prevProject = index > 0 ? projectsList[index - 1] : null;
const nextProject = index < projectsList.length - 1 ? projectsList[index + 1] : null;
