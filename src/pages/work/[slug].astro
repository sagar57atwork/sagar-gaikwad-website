---
export function getStaticPaths() {
  const projects = [
    { slug: "ripple-fable-research-os", type: "PRODUCT / SYSTEM", title: "Ripple Fable Research OS", summary: "A Windows-based marketing research workspace designed to turn scattered research into structured, usable analysis.", role: "Product / Research", tools: ["Windows App", "Research", "Strategy"], tags: ["Research", "AI", "Strategy"] },
    { slug: "retention-engine", type: "AGENCY SYSTEM", title: "Retention Engine", summary: "A Notion operating system for managing clients, projects, retention, strategy, analytics and delivery.", role: "Agency Operations", tools: ["Notion", "Agency Ops", "Retention"], tags: ["Notion", "Agency Ops", "Retention"] },
    { slug: "competitive-intelligence-report", type: "STRATEGIC PROJECT", title: "Competitive Intelligence Report", summary: "A structured competitive research system for understanding market positioning, competitors and opportunities.", role: "Research / Strategy", tools: ["Research", "Analysis"], tags: ["Research", "Acquisition"] },
    { slug: "local-search-growth", type: "PRACTICE CASE STUDY", title: "Local Search Growth", summary: "A research-led approach to Google Business Profile, local SEO and customer acquisition for local businesses.", role: "Practice Case Study", tools: ["SEO", "Local Search"], tags: ["Positioning", "Growth"] },
    { slug: "luma-living", type: "PRACTICE CASE STUDY", title: "Luma Living", summary: "A brand launch and go-to-market strategy exploring positioning, audience and growth direction.", role: "Practice Case Study", tools: ["Brand", "GTM"], tags: ["Brand", "GTM", "Strategy"] },
    { slug: "harvest-hearth", type: "PRACTICE CASE STUDY", title: "Harvest & Hearth", summary: "A strategic exploration of digital positioning, content and growth for a restaurant brand.", role: "Practice Case Study", tools: ["Strategy", "Content"], tags: ["Strategy", "Content", "Growth"] },
  ];
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, projectsList: projects, index },
  }));
}

const { project, projectsList, index } = Astro.props;
const { title, type, summary, role, tools, tags } = project;

const SITE = "https://sagar-gaikwad-website.pages.dev";

const isPractice = /practice|concept/i.test(type);

const detailSections = [
  "Context",
  "The problem",
  "Objective",
  "Research / approach",
  "Key findings",
  "Strategic thinking",
  "Solution / system / execution",
  "Outcome or learning",
];

const prevProject = index > 0 ? projectsList[index - 1] : null;
const nextProject = index < projectsList.length - 1 ? projectsList[index + 1] : null;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{project.title} | Sagar Gaikwad</title>
        <meta name="description" content={`${project.title} — selected work by Sagar Gaikwad.`} />
    <link rel="canonical" href={`${SITE}/work/${project.slug}`} />

    <meta property="og:title" content={`${project.title} | Sagar Gaikwad`} />
    <meta property="og:description" content={`${project.title} — selected work by Sagar Gaikwad.`} />
    <meta property="og:url" content={`${SITE}/work/${project.slug}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sagar Gaikwad" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${project.title} | Sagar Gaikwad`} />
    <meta name="twitter:description" content={`${project.title} — selected work by Sagar Gaikwad.`} />
    <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": title,
    "description": summary,
    "url": `${SITE}/work/${project.slug}`,
    "creator": {
      "@type": "Person",
      "name": "Sagar Gaikwad",
      "url": SITE
    }
  }
</script>
    <style>
      :root {
        --paper: #f7f6f2;
        --ink: #171717;
        --muted: #676761;
        --line: #d9d7d0;
        --orange: #f57722;
        --max: 1180px;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        line-height: 1.6;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .container {
        width: min(var(--max), calc(100% - 56px));
        margin: auto;
      }
      nav {
        height: 72px;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .back {
        font-size: 14px;
        font-weight: 650;
      }
      .back:hover {
        color: var(--orange);
      }
      main {
        padding: 100px 0 130px;
      }
      .eyebrow {
        color: var(--orange);
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      h1 {
        max-width: 900px;
        font-size: clamp(48px, 7vw, 92px);
        line-height: 0.98;
        letter-spacing: -0.06em;
        margin: 24px 0;
      }
      .summary {
        max-width: 680px;
        color: var(--muted);
        font-size: 18px;
        line-height: 1.75;
      }
      .tags {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 30px;
      }
      .tag {
        border: 1px solid var(--line);
        padding: 5px 9px;
        color: var(--muted);
        font-size: 12px;
      }
      .placeholder {
        margin-top: 60px;
        border-top: 1px solid var(--line);
        padding-top: 28px;
        color: var(--muted);
        font-size: 15px;
      }

      .practice {
        display: inline-block;
        margin-top: 20px;
        color: var(--orange);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        border: 1px solid var(--line);
        border-radius: 2px;
        padding: 4px 10px;
      }

      .sections {
        margin-top: 70px;
        border-top: 1px solid var(--line);
      }

      .detail-section {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 30px;
        padding: 28px 0;
        border-bottom: 1px solid var(--line);
      }

      .detail-label {
        color: var(--orange);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
        padding-top: 3px;
      }

      .detail-note {
        margin: 0;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.75;
        max-width: 640px;
      }

      .facts {
        margin-top: 40px;
        display: flex;
        flex-wrap: wrap;
        gap: 50px;
        padding-top: 30px;
        border-top: 1px solid var(--line);
      }

      .fact-label {
        color: var(--muted);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .1em;
        margin-bottom: 8px;
      }

      .fact-value {
        font-size: 16px;
      }

      .fact-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
      }

      .evidence {
        margin-top: 50px;
        padding: 40px 0 0;
        border-top: 1px solid var(--line);
      }

      .evidence h2 {
        font-size: 22px;
        letter-spacing: -.02em;
        margin: 0 0 8px;
      }

      .evidence p {
        color: var(--muted);
        font-size: 14px;
      }

      .evidence-grid {
        margin-top: 20px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .evidence-slot {
        border: 1px solid var(--line);
        background: #f0eee9;
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted);
        font-size: 13px;
        overflow: hidden;
        position: relative;
      }

      .evidence-slot img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }

      .nav-projects {
        margin-top: 70px;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding-top: 40px;
        border-top: 1px solid var(--line);
      }

      .nav-project {
        display: flex;
        flex-direction: column;
        gap: 6px;
        max-width: 45%;
      }

      .nav-project.next {
        text-align: right;
        align-items: flex-end;
      }

      .nav-label {
        color: var(--muted);
        font-size: 12px;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      .nav-title {
        font-weight: 600;
        letter-spacing: -.02em;
        font-size: 18px;
      }

      .cta {
        margin-top: 60px;
        padding-top: 40px;
        border-top: 1px solid var(--line);
      }

      .cta a {
        display: inline-block;
        color: var(--orange);
        font-size: 20px;
        font-weight: 600;
        letter-spacing: -.02em;
      }

      @media (max-width: 700px) {
        .container {
          width: calc(100% - 32px);
        }
        main {
          padding: 75px 0 100px;
        }
        .detail-section {
          grid-template-columns: 1fr;
          gap: 10px;
        }
        .evidence-grid {
          grid-template-columns: 1fr;
        }
        .nav-projects {
          flex-direction: column;
        }
        .nav-project {
          max-width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <nav class="container">
      <a href="/" class="back">← Back to portfolio</a>
      <a href="/work" class="back">All work →</a>
    </nav>
    <main>
      <div class="container">
        <div class="eyebrow">{type}</div>
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
        <div class="tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        {isPractice && <div class="practice">Practice Case Study</div>}

        <div class="sections">
          {detailSections.map((label) => (
            <div class="detail-section">
              <div class="detail-label">{label}</div>
              <p class="detail-note">Details to be curated for this project.</p>
            </div>
          ))}
        </div>

        <div class="facts">
          <div>
            <div class="fact-label">Project type</div>
            <div class="fact-value">{type}</div>
          </div>
          <div>
            <div class="fact-label">Role</div>
            <div class="fact-value">{role}</div>
          </div>
          <div>
            <div class="fact-label">Tools</div>
            <div class="fact-tags">
              {tools.map((t) => <span class="tag">{t}</span>)}
            </div>
          </div>
        </div>

        <div class="evidence">
          <h2>Evidence & screenshots</h2>
          <p>Visual assets and supporting material for this project will be added here.</p>
          <div class="evidence-grid">
            <div class="evidence-slot">Screenshot</div>
            <div class="evidence-slot">Screenshot</div>
            <div class="evidence-slot">Screenshot</div>
          </div>
        </div>

        <div class="nav-projects">
          {prevProject && (
            <a class="nav-project" href={`/work/${prevProject.slug}`}>
              <span class="nav-label">← Previous</span>
              <span class="nav-title">{prevProject.title}</span>
            </a>
          )}
          {nextProject && (
            <a class="nav-project next" href={`/work/${nextProject.slug}`}>
              <span class="nav-label">Next →</span>
              <span class="nav-title">{nextProject.title}</span>
            </a>
          )}
        </div>

        <div class="cta">
          <a href="/#contact">Let's talk →</a>
        </div>
      </div>
    </main>
  </body>
</html>
