---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Canonical base — update when the site is deployed to a real domain.
const SITE = "https://sagargaikwad.com";

const { title, description, pubDate, category, author, tags } = post.data;
const postUrl = `${SITE}/insights/${post.id}`;

// Order newest-first so prev/next navigation follows the listing order.
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const index = posts.findIndex((p) => p.id === post.id);
const nextArticle = index > 0 ? posts[index - 1] : null; // newer
const prevArticle = index < posts.length - 1 ? posts[index + 1] : null; // older
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title} | Sagar Gaikwad</title>

    <meta name="description" content={description} />

    <link rel="canonical" href={postUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={postUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <style>
      :root {
        --paper: #f7f6f2;
        --ink: #171717;
        --muted: #666660;
        --line: #d9d7d0;
        --orange: #f57722;
        --max: 800px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      nav {
        border-bottom: 1px solid var(--line);
      }

      .nav {
        width: min(1100px, calc(100% - 40px));
        height: 72px;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        font-weight: 650;
      }

      .back {
        color: var(--muted);
        font-size: 14px;
      }

      main {
        width: min(var(--max), calc(100% - 40px));
        margin: auto;
        padding: 110px 0 140px;
      }

      .category {
        color: var(--orange);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
      }

      h1 {
        margin: 20px 0;
        font-size: clamp(46px, 7vw, 76px);
        line-height: 1;
        letter-spacing: -.055em;
        font-weight: 600;
      }

      .description {
        color: var(--muted);
        font-size: 19px;
        line-height: 1.65;
        margin-bottom: 25px;
      }

      .meta {
        color: var(--muted);
        font-size: 13px;
        padding-bottom: 40px;
        border-bottom: 1px solid var(--line);
      }

      article {
        padding-top: 55px;
        font-size: 18px;
        line-height: 1.8;
      }

      article h2 {
        margin-top: 55px;
        font-size: 32px;
        line-height: 1.2;
        letter-spacing: -.03em;
      }

      article h3 {
        margin-top: 40px;
        font-size: 24px;
      }

      article p {
        margin: 0 0 25px;
      }

      article ul,
      article ol {
        margin-bottom: 30px;
      }

      article li {
        margin-bottom: 10px;
      }

      article a {
        color: var(--orange);
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      article strong {
        font-weight: 650;
      }

      article em {
        font-style: italic;
      }

      article blockquote {
        margin: 30px 0;
        padding-left: 20px;
        border-left: 3px solid var(--orange);
        color: var(--muted);
        font-style: italic;
      }

      article code {
        background: #ececea;
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 15px;
      }

      article pre {
        background: #ececea;
        padding: 20px;
        border-radius: 4px;
        overflow-x: auto;
        margin: 0 0 30px;
        line-height: 1.6;
      }

      article pre code {
        background: none;
        padding: 0;
        font-size: 14px;
      }

      article img {
        max-width: 100%;
        height: auto;
        margin: 30px 0;
      }

      article hr {
        border: none;
        border-top: 1px solid var(--line);
        margin: 40px 0;
      }

      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 16px 0 0;
      }

      .tag {
        color: var(--muted);
        font-size: 12px;
        border: 1px solid var(--line);
        padding: 4px 10px;
        border-radius: 2px;
      }

      .article-posts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 70px;
        padding-top: 40px;
        border-top: 1px solid var(--line);
      }

      .nav-post {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .nav-post.next {
        text-align: right;
      }

      .nav-label {
        color: var(--muted);
        font-size: 12px;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      .nav-title {
        font-weight: 600;
        letter-spacing: -.02em;
        font-size: 18px;
      }

      .cta {
        margin-top: 60px;
        padding-top: 40px;
        border-top: 1px solid var(--line);
      }

      .cta a {
        display: inline-block;
        color: var(--orange);
        font-size: 20px;
        font-weight: 600;
        letter-spacing: -.02em;
      }

      @media (max-width: 700px) {
        main {
          padding-top: 70px;
        }

        .article-posts {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <nav>
      <div class="nav">
        <a href="/" class="brand">Sagar Gaikwad</a>
        <a href="/insights" class="back">← All insights</a>
      </div>
    </nav>

    <main>
      <div class="category">{category}</div>

      <h1>{title}</h1>

      <p class="description">{description}</p>

      <div class="meta">
        {pubDate.toLocaleDateString("en-US", {
          day: "numeric",
          month: "long",
          year: "numeric",
        })}
        · {author}
      </div>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}

      <article>
        <Content />
      </article>

      <div class="article-posts">
        {prevArticle && (
          <a class="nav-post" href={`/insights/${prevArticle.id}`}>
            <span class="nav-label">← Previous</span>
            <span class="nav-title">{prevArticle.data.title}</span>
          </a>
        )}
        {nextArticle && (
          <a class="nav-post next" href={`/insights/${nextArticle.id}`}>
            <span class="nav-label">Next →</span>
            <span class="nav-title">{nextArticle.data.title}</span>
          </a>
        )}
      </div>

      <div class="cta">
        <a href="/#contact">Let's talk →</a>
      </div>
    </main>
  </body>
</html>