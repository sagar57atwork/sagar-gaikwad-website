---
import { getCollection } from "astro:content";

const SITE = "https://sagar-gaikwad-website.pages.dev";

const posts = await getCollection("blog");

const sortedPosts = posts.sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>Insights | Sagar Gaikwad</title>

        <meta
      name="description"
      content="Marketing strategy, market research, AI, growth and modern marketing insights by Sagar Gaikwad."
    />

    <link rel="canonical" href={`${SITE}/insights`} />

    <meta property="og:title" content="Insights | Sagar Gaikwad" />
    <meta property="og:description" content="Marketing strategy, market research, AI, growth and modern marketing insights by Sagar Gaikwad." />
    <meta property="og:url" content={`${SITE}/insights`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sagar Gaikwad" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Insights | Sagar Gaikwad" />
    <meta name="twitter:description" content="Marketing strategy, market research, AI, growth and modern marketing insights by Sagar Gaikwad." />

    <style>
      :root {
        --paper: #f7f6f2;
        --paper-dark: #eeece6;
        --ink: #171717;
        --muted: #666660;
        --line: #d9d7d0;
        --orange: #f57722;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      nav {
        border-bottom: 1px solid var(--line);
      }

      .nav {
        width: min(1100px, calc(100% - 40px));
        height: 72px;
        margin: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        font-weight: 650;
      }

      .back {
        color: var(--muted);
        font-size: 14px;
      }

      main {
        width: min(1100px, calc(100% - 40px));
        margin: auto;
        padding: 100px 0 130px;
      }

      .label {
        color: var(--orange);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .15em;
        text-transform: uppercase;
      }

      h1 {
        margin: 20px 0 70px;
        font-size: clamp(52px, 8vw, 88px);
        line-height: .98;
        letter-spacing: -.06em;
        font-weight: 600;
      }

      .posts {
        border-top: 1px solid var(--line);
      }

      .post {
        display: grid;
        grid-template-columns: 70px 160px 1fr 30px;
        gap: 25px;
        align-items: center;
        padding: 32px 0;
        border-bottom: 1px solid var(--line);
        transition: background 0.25s ease;
      }

      .post:hover {
        background: var(--paper-dark);
      }

      .number {
        color: var(--muted);
        font-size: 13px;
      }

      .category {
        color: var(--orange);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
      }

      .cat-row {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .featured {
        color: var(--orange);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        border: 1px solid var(--line);
        border-radius: 2px;
        padding: 2px 7px;
      }

      h2 {
        margin: 0;
        font-size: 23px;
        font-weight: 550;
        letter-spacing: -.025em;
      }

      .desc {
        margin: 10px 0 14px;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.6;
        max-width: 620px;
      }

      .date {
        color: var(--muted);
        font-size: 13px;
        letter-spacing: .02em;
        text-transform: uppercase;
      }

      .arrow {
        color: var(--orange);
        font-size: 18px;
        transition: transform 0.25s ease;
      }

      .post:hover .arrow {
        transform: translateX(3px);
      }

      .empty {
        padding: 50px 0;
        color: var(--muted);
      }

      @media (max-width: 700px) {
        main {
          padding-top: 70px;
        }

        .post {
          grid-template-columns: 40px 1fr 25px;
        }

        .category {
          grid-column: 2;
        }

        .cat-row {
          grid-column: 2;
        }

        .info {
          grid-column: 2;
        }
      }
    </style>
  </head>

  <body>
    <nav>
      <div class="nav">
        <a href="/" class="brand">Sagar Gaikwad</a>
        <a href="/" class="back">← Portfolio</a>
      </div>
    </nav>

    <main>
      <div class="label">05 / Insights</div>

      <h1>Ideas & research.</h1>

      <div class="posts">
        {sortedPosts.length > 0 ? (
          sortedPosts.map((post, index) => (
            <a class="post" href={`/insights/${post.id}`}>
              <div class="number">
                {String(index + 1).padStart(2, "0")}
              </div>

              <div class="cat-row">
                <div class="category">
                  {post.data.category}
                </div>

                {post.data.featured && (
                  <span class="featured">Featured</span>
                )}
              </div>

              <div class="info">
                <h2>{post.data.title}</h2>
                <p class="desc">{post.data.description}</p>
                <span class="date">
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </span>
              </div>

              <div class="arrow">↗</div>
            </a>
          ))
        ) : (
          <div class="empty">
            Insights coming soon.
          </div>
        )}
      </div>
    </main>
  </body>
</html>