---
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 | Sagar Gaikwad</title>
    <meta name="robots" content="noindex" />
    <style>
      :root {
        --paper: #f7f6f2;
        --ink: #171717;
        --muted: #666660;
        --line: #d9d7d0;
        --orange: #f57722;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .wrap {
        width: min(800px, calc(100% - 40px));
        margin: auto;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      nav {
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line);
      }
      .brand {
        font-weight: 650;
      }
      .back {
        color: var(--muted);
        font-size: 14px;
      }
      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 80px 0;
      }
      .code {
        color: var(--orange);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .15em;
        text-transform: uppercase;
      }
      .big {
        margin: 24px 0;
        font-size: clamp(90px, 22vw, 220px);
        line-height: .9;
        letter-spacing: -.06em;
        font-weight: 600;
      }
      .msg {
        color: var(--muted);
        font-size: 18px;
        margin: 0 0 40px;
      }
      .home {
        display: inline-block;
        border-bottom: 1px solid var(--ink);
        font-size: 16px;
        font-weight: 650;
      }
      .home:hover {
        color: var(--orange);
        border-color: var(--orange);
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <nav>
        <a href="/" class="brand">Sagar Gaikwad</a>
        <a href="/insights" class="back">Insights</a>
      </nav>
      <main>
        <div class="code">Error 404</div>
        <h1>404</h1>
        <p class="msg">Looks like this page doesn't exist.</p>
        <a class="home" href="/">Back to portfolio →</a>
      </main>
    </div>
  </body>
</html>