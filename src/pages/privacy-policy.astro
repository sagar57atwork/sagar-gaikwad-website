---
const SITE = "https://sagargaikwad.com";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Privacy Policy | Sagar Gaikwad</title>
    <meta
      name="description"
      content="Privacy policy for Sagar Gaikwad, Marketing Strategist. This website does not collect any personal data, use analytics, deploy cookies, run marketing campaigns, process payments, or maintain user accounts."
    />
    <link rel="canonical" href={SITE} />
    <meta name="author" content="Sagar Gaikwad" />

    <meta property="og:title" content="Privacy Policy | Sagar Gaikwad" />
    <meta property="og:description" content="Privacy policy for Sagar Gaikwad, Marketing Strategist. This website does not collect any personal data, use analytics, deploy cookies, run marketing campaigns, process payments, or maintain user accounts." />
    <meta property="og:url" content={SITE} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sagar Gaikwad" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Privacy Policy | Sagar Gaikwad" />
                <meta name="twitter:description" content="Privacy policy for Sagar Gaikwad, Marketing Strategist. This website does not collect any personal data, use analytics, deploy cookies, run marketing campaigns, process payments, or maintain user accounts." />
    <style>
      :root { --paper: #f7f6f2; --ink: #171717; --muted: #666660; --line: #d9d7d0; --orange: #f57722; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: Inter, sans-serif; line-height: 1.6; }
      a { color: var(--orange); text-decoration: underline; }
      .container { width: min(1100px, calc(100% - 40px)); margin: auto; }
      nav { border-bottom: 1px solid var(--line); }
      .back { color: var(--muted); font-size: 14px; }
      main { padding: 80px 0; }
      .policy-section { margin-bottom: 40px; }
      .policy-section h2 { color: var(--ink); font-size: 20px; margin-top: 0; }
      .policy-section p { color: var(--muted); margin: 0 0 16px; }
      .policy-section ul { color: var(--muted); margin: 0 0 16px; padding-left: 20px; }
      .footer-link { color: var(--ink); }
    </style>
  </head>
  <body>
    <nav>
      <div class="container nav">
        <a href="/" class="brand">Sagar Gaikwad</a>
        <a href="/#contact" class="back">Let's talk →</a>
      </div>
    </nav>
    <main>
      <div class="container">
        <div class="policy-section">
          <h2>Effective date: August 15, 2026</h2>
          <p>This privacy policy describes how Sagar Gaikwad collects, uses, and shares information when you visit this website.</p>
          
          <h3>Information we do not collect</h3>
          <p>This website does not collect any personal data, use analytics, deploy cookies, run marketing campaigns, process payments, or maintain user accounts.</p>
          
          <h3>External links</h3>
          <p>The website contains links to external services, including:</p>
          <ul>
            <li><a href="https://www.linkedin.com/in/sagargaikwadofficial/" target="_blank">LinkedIn profile</a></li>
            <li><a href="https://github.com/sagar57atwork" target="_blank">GitHub profile</a></li>
            <li><a href="mailto:sagar57.atwork@gmail.com">Email contact</a></li>
          </ul>
          <p>These external services have their own privacy policies. We encourage you to review them.</p>
          
          <h3>Changes to this policy</h3>
          <p>We may update this privacy policy from time to time. We will post any changes on this page.</p>
        </div>
        
        <div class="footer-link">
          <a href="/">Back to homepage</a>
        </div>
      </div>
    </main>
    <footer>
      <div class="container footer-inner">
        <div>© 2026 Sagar Gaikwad · Marketing Strategist</div>
        <div class="footer-links">
          <a href="/work">Work</a>
          <a href="/insights">Insights</a>
          <a href="https://www.linkedin.com/in/sagargaikwadofficial/">LinkedIn</a>
          <a href="https://github.com/sagar57atwork">GitHub</a>
          <a href="mailto:sagar57.atwork@gmail.com">Email</a>
        </div>
      </div>
    </footer>
  </body>
</html>